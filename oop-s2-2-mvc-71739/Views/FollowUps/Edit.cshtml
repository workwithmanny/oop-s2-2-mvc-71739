@model oop_s2_2_mvc_71739.Models.FollowUp

@{
    ViewData["Title"] = "Edit Follow-Up";
}

<h1>Edit Follow-Up</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="InspectionId" class="control-label"></label>
        <select asp-for="InspectionId" class="form-control" asp-items="ViewBag.InspectionId"></select>
        <span asp-validation-for="InspectionId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DueDate" class="control-label"></label>
        <input asp-for="DueDate" class="form-control" />
        <span asp-validation-for="DueDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Status" class="control-label"></label>
        <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<FollowUpStatus>()"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ClosedDate" class="control-label"></label>
        <input asp-for="ClosedDate" class="form-control" />
        <span asp-validation-for="ClosedDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>
