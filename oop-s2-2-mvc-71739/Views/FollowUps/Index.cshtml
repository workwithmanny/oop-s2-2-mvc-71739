@model IEnumerable<oop_s2_2_mvc_71739.Models.FollowUp>

@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Follow-Ups</h1>
        <p class="page-subtitle">Manage open and closed actions</p>
    </div>
</div>

@if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Inspector))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}

<div class="data-card">
    <div class="data-card-header">Follow-Up Schedule</div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Premises</th>
                    <th>Inspection Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model)
{
                var statusClass = item.Status == FollowUpStatus.Open ? "badge-status-open" : "badge-status-closed";
                <tr>
                    <td>@item.Inspection?.Premises?.Name</td>
                    <td>@item.Inspection?.InspectionDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.DueDate.ToString("yyyy-MM-dd")</td>
                    <td><span class="badge-soft @statusClass">@item.Status</span></td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                        @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Inspector))
                        {
                            <span> | </span><a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <span> | </span><a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        }
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>
