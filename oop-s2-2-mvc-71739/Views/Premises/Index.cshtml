@model IEnumerable<oop_s2_2_mvc_71739.Models.Premises>

@{
    ViewData["Title"] = "Premises";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Premises</h1>
        <p class="page-subtitle">Manage registered food premises</p>
    </div>
</div>

@if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Inspector))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}

<div class="data-card">
    <div class="data-card-header">All Premises</div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Town</th>
                    <th>Risk Rating</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model)
{
                var badgeClass = item.RiskRating switch
                {
                    RiskRating.High => "badge-risk-high",
                    RiskRating.Medium => "badge-risk-medium",
                    _ => "badge-risk-low"
                };
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Town</td>
                    <td><span class="badge-soft @badgeClass">@item.RiskRating</span></td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                        @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Inspector))
                        {
                            <span> | </span><a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <span> | </span><a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        }
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>
